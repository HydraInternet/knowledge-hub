filters:
  and:
    - file.path.startsWith("Projects/")
    - file.basename != "__template__"
views:
  - type: table
    name: Active Projects
    filters:
      and:
        - Status == "Active"
    order:
      - Status
      - Assignee
      - file.name
    sort:
      - property: formula.Status
        direction: ASC
      - property: Status
        direction: ASC
  - type: table
    name: All Projects
    order:
      - Status
      - Assignee
      - file.name
    sort: []
